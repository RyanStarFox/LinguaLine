    "settings_daily_count_hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某一方向可以是 0 句，但两个方向加起来至少要有 1 句。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某一方向可以是 0 句，但兩個方向加起來至少要有 1 句。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either direction can be zero, but together they need at least one sentence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの方向も 0 文にできますが、合わせて少なくとも 1 文必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 방향은 0문장으로 둘 수 있지만, 두 방향을 합쳐 최소 한 문장이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une direction peut être à 0, mais les deux ensemble doivent compter au moins une phrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Richtung darf 0 sein, zusammen brauchen sie aber mindestens einen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dirección puede ser 0, pero entre las dos tiene que haber al menos una frase."
          }
        }
      }
    },
