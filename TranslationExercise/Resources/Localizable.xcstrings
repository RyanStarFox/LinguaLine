    "stats_arrange_wide": {
      "localizations": {
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这是宽屏的排列。拖动卡片改变位置，点眼睛隐藏。两张半宽卡片会并排，整行则独占一行。窄屏的排列另外保存。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這是寬螢幕的排列。拖動卡片改變位置，點眼睛隱藏。兩張半寬卡片會並排，整列則獨占一列。窄螢幕的排列另外保存。" } },
        "en": { "stringUnit": { "state": "translated", "value": "This is the wide layout. Drag a card to move it, and use the eye to hide it. Two half-width cards sit side by side. The narrow layout is saved separately." } },
        "ja": { "stringUnit": { "state": "translated", "value": "これは広い画面の並びです。ドラッグで位置を変え、目のアイコンで隠せます。半幅のカードは二つ並びます。狭い画面の並びは別に保存されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "넓은 화면 배치입니다. 끌어 옮기고, 눈 아이콘으로 숨깁니다. 반 너비 카드 두 장은 나란히 놓입니다. 좁은 화면 배치는 따로 저장됩니다." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Disposition large. Glissez une carte pour la déplacer, et l’œil pour la masquer. Deux cartes en demi-largeur se placent côte à côte. La disposition étroite est enregistrée à part." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dies ist das breite Layout. Ziehen Sie eine Karte, und blenden Sie sie mit dem Auge aus. Zwei halbe Karten stehen nebeneinander. Das schmale Layout wird getrennt gespeichert." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta es la disposición ancha. Arrastra una tarjeta para moverla y usa el ojo para ocultarla. Dos de medio ancho quedan juntas. La disposición estrecha se guarda aparte." } }
      }
    },
    "stats_arrange_narrow": {
      "localizations": {
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这是窄屏的排列。拖动卡片改变上下顺序，点眼睛隐藏。这里和宽屏分开保存。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這是窄螢幕的排列。拖動卡片改變上下順序，點眼睛隱藏。這裡和寬螢幕分開保存。" } },
        "en": { "stringUnit": { "state": "translated", "value": "This is the narrow layout. Drag a card to change the order, and use the eye to hide it. It is saved separately from the wide layout." } },
        "ja": { "stringUnit": { "state": "translated", "value": "これは狭い画面の並びです。ドラッグで順序を変え、目のアイコンで隠せます。広い画面とは別に保存されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "좁은 화면 배치입니다. 끌어 순서를 바꾸고, 눈 아이콘으로 숨깁니다. 넓은 화면과 따로 저장됩니다." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Disposition étroite. Glissez une carte pour changer l’ordre, et l’œil pour la masquer. Elle est enregistrée à part de la disposition large." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dies ist das schmale Layout. Ziehen Sie eine Karte, und blenden Sie sie mit dem Auge aus. Es wird getrennt vom breiten Layout gespeichert." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta es la disposición estrecha. Arrastra una tarjeta para cambiar el orden y usa el ojo para ocultarla. Se guarda aparte de la disposición ancha." } }
      }
    },
