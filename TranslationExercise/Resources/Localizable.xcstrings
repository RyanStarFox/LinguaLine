    "today_placement_body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只测这个方向，大约五题。做完后按结果设定这一边的难度。也可以跳过，从日常交流开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只測這個方向，大約五題。做完後按結果設定這一邊的難度。也可以跳過，從日常交流開始。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About five prompts for this direction. The result sets this side's level. You can also skip and start at everyday conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この方向だけを五問ほど測ります。結果でこちらの難度を決めます。飛ばして日常会話から始めることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방향만 다섯 문제 정도입니다. 결과로 이쪽 난이도를 정합니다. 건너뛰고 일상 회화부터 시작할 수도 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ cinq textes pour ce sens. Le résultat règle ce côté. Vous pouvez aussi commencer par la conversation courante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa fünf Aufgaben nur für diese Richtung. Das Ergebnis legt diese Seite fest. Sie können auch mit Alltagssprache beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas cinco frases solo para esta dirección. El resultado fija este lado. También puedes empezar por la conversación diaria."
          }
        }
      }
    },
