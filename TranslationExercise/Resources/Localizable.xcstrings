    "streak_shield_rule": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 10 天连胜获得一面盾牌，最多两面。补上缺的日子后，连胜天数不变，下一次完成才加一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 10 天連勝獲得一面盾牌，最多兩面。補上缺的日子後，連勝天數不變，下一次完成才加一天。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 10 streak days earns one shield, up to two. Filling a missed day keeps the count. The next finished day adds one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10日連続ごとに盾を1枚、最大2枚。欠かした日を埋めても連続日数はそのままで、次に達成した日に1日増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10일 연속마다 방패 1개, 최대 2개. 빠진 날을 메워도 연속 일수는 그대로이고, 다음에 완료하면 하루가 늘어요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les 10 jours de série, un bouclier, deux au maximum. Il comble un jour manqué sans augmenter le compte. Le jour suivant terminé ajoute un jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 10 Tage in Folge gibt es einen Schild, höchstens zwei. Er füllt einen versäumten Tag, ohne den Zähler zu erhöhen. Der nächste abgeschlossene Tag zählt plus eins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 10 días de racha dan un escudo, dos como máximo. Cubre un día perdido sin sumar al conteo. El siguiente día completado suma uno."
          }
        }
      }
    },
