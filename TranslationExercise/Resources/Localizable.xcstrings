    "settings_price_hint": {
      "localizations": {
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按每百万 token 计价。可以只填输入或输出，留空的那一边不计入。不填则统计里不显示价格。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "按每百萬 token 計價。可以只填輸入或輸出，留空的那一邊不計入。不填則統計裡不顯示價格。" } },
        "en": { "stringUnit": { "state": "translated", "value": "Price per million tokens. You can fill in only input or output; a blank side is left out. Leave both blank to hide the price in Stats." } },
        "ja": { "stringUnit": { "state": "translated", "value": "100万トークンあたりの価格です。入力か出力だけでも記入できます。空欄の側は計算しません。両方空なら統計に価格を出しません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "백만 토큰당 가격입니다. 입력이나 출력만 적어도 됩니다. 빈칸은 계산하지 않습니다. 둘 다 비우면 통계에 가격을 보이지 않습니다." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Prix pour un million de tokens. On peut ne remplir que l'entrée ou la sortie ; un côté vide n'est pas compté. Si les deux sont vides, le prix n'apparaît pas dans les statistiques." } },
        "de": { "stringUnit": { "state": "translated", "value": "Preis je Million Tokens. Eingabe oder Ausgabe allein genügt; eine leere Seite wird nicht gerechnet. Bleiben beide leer, zeigt die Statistik keinen Preis." } },
        "es": { "stringUnit": { "state": "translated", "value": "Precio por millón de tokens. Se puede rellenar solo la entrada o la salida; el lado vacío no cuenta. Si ambos quedan vacíos, las estadísticas no muestran el precio." } }
      }
    },
