    "settings_dictionary_unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个语言还没有可下载的中文对照词典，划词会问模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個語言還沒有可下載的中文對照詞典，劃詞會問模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No downloadable Chinese dictionary for this language yet. Lookups use the model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語には、ダウンロードできる中国語との辞書がまだありません。単語はモデルに聞きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어에는 받을 수 있는 중국어 대역 사전이 아직 없습니다. 단어는 모델에 묻습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de dictionnaire chinois téléchargeable pour cette langue. La recherche passe par le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Sprache gibt es noch kein ladbares Wörterbuch mit Chinesisch. Nachschlagen übernimmt das Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay un diccionario chino descargable para este idioma. La búsqueda usa el modelo."
          }
        }
      }
    },
