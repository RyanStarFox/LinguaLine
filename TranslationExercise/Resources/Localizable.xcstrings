    "sync_error_icloud": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备还没有可用的 iCloud 云盘。请用带 iCloud 能力的签名运行，或改用 WebDAV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置還沒有可用的 iCloud 雲碟。請用帶 iCloud 能力的簽名執行，或改用 WebDAV。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive is not available. Sign the app with iCloud, or use WebDAV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive を利用できません。iCloud 対応の署名で実行するか、WebDAV を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive를 사용할 수 없습니다. iCloud 서명으로 실행하거나 WebDAV를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive n’est pas disponible. Signez l’app avec iCloud, ou utilisez WebDAV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive ist nicht verfügbar. Signiere die App mit iCloud oder nutze WebDAV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive no está disponible. Firma la app con iCloud o usa WebDAV."
          }
        }
      }
    },
