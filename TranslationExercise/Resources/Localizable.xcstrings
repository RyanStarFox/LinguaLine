          "stringUnit": {
            "state": "translated",
            "value": "連勝斷了。用盾牌補上之後，天數保持不變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The streak broke. A shield keeps the count where it is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続が途切れました。盾を使うと日数はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속이 끊겼어요. 방패를 쓰면 일수는 그대로예요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La série est interrompue. Un bouclier conserve le compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serie ist unterbrochen. Ein Schild hält den Zähler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La racha se cortó. Un escudo mantiene el conteo."
          }
        }
      }
    },
