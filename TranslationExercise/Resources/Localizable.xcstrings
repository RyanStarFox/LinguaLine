    "settings_dictionary_prefer_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后，查得到就直接显示，不再问模型。关掉后，划词一律问模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開後，查得到就直接顯示，不再問模型。關掉後，劃詞一律問模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, a dictionary hit is shown directly. When off, selected words always go to the model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンのときは辞書にあればそれを表示します。オフのときは選択した語をいつもモデルに聞きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 사전에 있을 때 바로 보여 줍니다. 끄면 선택한 단어를 항상 모델에 묻습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : une entrée du dictionnaire s’affiche tout de suite. Désactivé : le mot sélectionné va toujours au modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: ein Treffer im Wörterbuch erscheint sofort. Aus: markierte Wörter gehen immer ans Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: si el diccionario tiene la palabra, se muestra al momento. Desactivado: la selección siempre va al modelo."
          }
        }
      }
    },
